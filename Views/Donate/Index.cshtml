@model Donation
@{ ViewData["Title"] = "Donate"; }
<div class="card form-card"><div class="card-body p-4"><h1>Make a donation</h1><p>Prototype only — no payment is processed.</p><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row"><div class="col-md-6"><label asp-for="DonationType"></label><select asp-for="DonationType" class="form-select"><option>One-time</option><option>Recurring</option></select></div><div class="col-md-6"><label asp-for="Currency"></label><select asp-for="Currency" class="form-select"><option>ZAR</option><option>USD</option><option>EUR</option></select></div></div><label asp-for="Amount" class="mt-3"></label><input asp-for="Amount" class="form-control" type="number" step="0.01"/><div class="form-check mt-3"><input asp-for="IsAnonymous" class="form-check-input"/><label asp-for="IsAnonymous" class="form-check-label">Donate anonymously</label></div><button class="btn btn-warning mt-4">Record donation</button></form></div></div>
