@model Donation
@{ ViewData["Title"] = "Donation certificate"; }
<div class="card form-card border-success"><div class="card-body p-4"><h1 class="text-success">Donation confirmed</h1><p>Thank you for your generosity. This is a prototype certificate, not an official tax document.</p><dl class="row"><dt class="col-sm-5">Certificate number</dt><dd class="col-sm-7">@Model.TaxCertificateNumber</dd><dt class="col-sm-5">Donor</dt><dd class="col-sm-7">@Model.DonorName</dd><dt class="col-sm-5">Amount</dt><dd class="col-sm-7">@Model.Currency @Model.Amount.ToString("N2")</dd><dt class="col-sm-5">Donation type</dt><dd class="col-sm-7">@Model.DonationType</dd><dt class="col-sm-5">Date</dt><dd class="col-sm-7">@Model.DonationDate.ToString("dd MMMM yyyy")</dd></dl><button class="btn btn-outline-primary" onclick="window.print()">Print certificate</button></div></div>
