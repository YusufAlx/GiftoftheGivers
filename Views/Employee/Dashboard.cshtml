@{ViewData["Title"]="Employee dashboard";var volunteers=ViewBag.Volunteers as List<Volunteer>;var updates=ViewBag.Updates as List<ProjectUpdate>;}<h1>Employee dashboard</h1><div class="row g-4"><div class="col-lg-5"><div class="card"><div class="card-body"><h2>Post a relief update</h2><form asp-action="PostUpdate" method="post"><label>Project name</label><input name="ProjectName" class="form-control" required/><label class="mt-3">Update</label><textarea name="UpdateText" class="form-control" required></textarea><button class="btn btn-primary mt-3">Publish update</button></form></div></div></div><div class="col-lg-7"><div class="card"><div class="card-body"><h2>Volunteer sign-ups</h2><table class="table"><thead><tr><th>Name</th><th>Skills</th><th>Availability</th></tr></thead><tbody>@foreach(var v in volunteers ?? []){<tr><td>@v.FullName</td><td>@v.Skills</td><td>@v.Availability</td></tr>}</tbody></table></div></div></div></div><div class="card mt-4"><div class="card-body"><h2>Published updates</h2>@foreach(var u in updates ?? []){<article class="border-bottom py-2"><strong>@u.ProjectName</strong><p class="mb-0">@u.UpdateText</p><small>@u.PostedDate.ToLocalTime().ToString("dd MMM yyyy") · @u.PostedBy</small></article>}</div></div>
